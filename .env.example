# CodeOrbit Environment Configuration Example

# Application URL & Port
APP_URL="https://ais-dev-qb74bkjasobqvcubyogsxu-73402141569.asia-southeast1.run.app"
PORT=3000

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Resend API Key for Automated Email Reminders
RESEND_API_KEY="re_your_api_key_here"
# Optional: Verified domain sender in Resend to deliver to all user emails (e.g. "CodeOrbit <reminders@yourdomain.com>")
RESEND_FROM_EMAIL=""

# Optional: SMTP Configuration (e.g. Gmail App Password) to deliver to ALL registered user emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
